(authors) => (blog) => main_template.ori({
	title: blog.title
	description: blog.description
	og_description: blog.og_description
	pub_time: blog.pub_time
	mod_time: blog.mod_time
	author: blog.author
	article: true
	stylesheet: "pages/blog-individual.css"
	canonical: `/blog/${ blog.file_name }`

_body: `
  <article class="h-entry" data-pagefind-filter="Content Type:Blog">
    <header>
      <div>
        <h1 class="p-name">${ blog.title }</h1>
        <p>Written by <a href="#about-author">${ blog.author }</a></p>
        <ul>
          <li>Published <time class="dt-published" datetime="${ blog.pub_time }" title="Date of first publication.">${ functions/pretty-date.js(blog.pub_time) }</time></li>
          ${ blog.mod_time ? `<li>Updated <time class="dt-updated" datetime="${ blog.mod_time }" title="Date of last notable modification.">${ functions/pretty-date.js(blog.mod_time) }</time></li>` : '' }
        </ul>
      </div>
    </header>

    <div class="readable e-content" data-pagefind-body>
      ${ blog._body }
    </div>

    <section class="readable" id="about-author" data-pagefind-ignore>
      <h2>About the Author</h2>
      <div class="author-card">
        <img src="${ authors.avatar }" alt="A portrait of ${ authors.name }.">
        <div>
          <p class="author-name">${ authors.name }</p>
          <p class="author-bio">${ authors.bio }</p>
          <ul class="author-links">
            <li>${ authors.stoat }</li>
            ${ Tree.map(authors.links, (link) => `<li><a href="${ link.url }">${ link.label }</a></li>`) }
          </ul>
        </div>
      </div>
    </section>
  </article>
`})
