(doc, sidebar) => main_template.ori({
	title: doc.title
	description: doc.description
	og_description: doc.og_description
	stylesheet: "pages/docs.css"

	_body: `
    <section data-pagefind-filter="Content Type:Documentation">
      <button id="sidebar-toggle" popovertarget="sidebar-menu" aria-expanded="false" aria-label="Show sidebar navigation">
        <svg class="icon-menu" aria-hidden="true" viewBox="0 -960 960 960"><path d="M120-240v-80h720v80zm0-200v-80h720v80zm0-200v-80h720v80z"/></svg>
        <svg class="icon-close" aria-hidden="true" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224z"/></svg>
        Contents
      </button>

      <h1>${ doc.title }</h1>

      <div data-pagefind-body>
        ${ doc._body }
      </div>
    </section>

    <aside id="sidebar-menu">
      <button class="close-sidebar" popovertarget="sidebar-menu" aria-label="Close menu">
        <svg aria-hidden="true" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224z"/></svg>
      </button>

      <h2>Index</h2>

      ${ sidebar }
    </aside>

    <script src="/assets/scripts/docs-sidebar.js" defer></script>
` })
